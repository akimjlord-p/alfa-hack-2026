# Create .env.production on the server; never commit it.
# For a temporary IP-only demo; Caddy serves HTTPS with a locally issued certificate.
# Browsers will warn until a trusted domain/certificate is configured.
SITE_ADDRESS=95.216.156.245
# Use only letters and digits to avoid URL-encoding issues in DATABASE_URL.
POSTGRES_PASSWORD=replacewithlongrandomalphanumericpassword
DEMO_USER=viewer
# Generate with: docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'your-password'
# When using a Compose env file, double each $ in the bcrypt hash as $$.
DEMO_PASSWORD_HASH=replace_with_bcrypt_hash
YANDEX_FOLDER_ID=replace_with_folder_id
YANDEX_API_KEY=replace_with_api_key
YANDEX_MODEL=aliceai-llm-flash
