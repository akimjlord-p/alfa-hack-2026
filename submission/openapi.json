  "components": {
    "schemas": {
      "ApplicationCreate": {
        "properties": {
          "offer_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 2,
            "title": "Offer Id"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "applicant_name": {
            "type": "string",
            "maxLength": 140,
            "minLength": 2,
            "title": "Applicant Name"
          },
          "company_name": {
            "type": "string",
            "maxLength": 180,
            "minLength": 2,
            "title": "Company Name"
          },
          "contact_email": {
            "type": "string",
            "format": "email",
            "title": "Contact Email"
          },
          "contact_phone": {
            "type": "string",
            "maxLength": 40,
            "minLength": 6,
            "title": "Contact Phone"
          },
          "requested_amount": {
            "type": "integer",
            "maximum": 500000000.0,
            "minimum": 100000.0,
            "title": "Requested Amount"
          }
        },
        "type": "object",
        "required": [
          "offer_id",
          "applicant_name",
          "company_name",
          "contact_email",
          "contact_phone",
          "requested_amount"
        ],
        "title": "ApplicationCreate"
      },
      "ApplicationInfo": {
        "properties": {
          "note": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 3,
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "note"
        ],
        "title": "ApplicationInfo"
      },
      "ApplicationTransition": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 3,
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "status",
          "note"
        ],
        "title": "ApplicationTransition"
      },
      "DemoLogin": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 80,
            "minLength": 3,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 120,
            "minLength": 3,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "DemoLogin"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Profile": {
        "properties": {
          "amount": {
            "type": "integer",
            "maximum": 500000000.0,
            "minimum": 100000.0,
            "title": "Amount"
          },
          "term": {
            "type": "integer",
            "maximum": 240.0,
            "minimum": 1.0,
            "title": "Term"
          },
          "purpose": {
            "type": "string",
            "title": "Purpose"
          },
          "legal_form": {
            "type": "string",
            "title": "Legal Form"
          },
          "business_age_months": {
            "type": "integer",
            "maximum": 600.0,
            "minimum": 0.0,
            "title": "Business Age Months"
          },
          "revenue_monthly": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Revenue Monthly"
          },
          "collateral": {
            "type": "string",
            "title": "Collateral"
          },
          "has_overdue": {
            "type": "boolean",
            "title": "Has Overdue",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "amount",
          "term",
          "purpose",
          "legal_form",
          "business_age_months",
          "revenue_monthly",
          "collateral"
        ],
        "title": "Profile"
      },
      "UserTurn": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 3000,
            "title": "Text",
            "default": ""
          },
          "choice_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Choice Id"
          }
        },
        "type": "object",
        "title": "UserTurn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}